{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run API (reload)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\uvicorn.exe",
      "args": ["app.main:app", "--reload"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "DB migrate (alembic upgrade head)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\alembic.exe",
      "args": ["upgrade", "head"],
      "problemMatcher": []
    }
  ]
}
